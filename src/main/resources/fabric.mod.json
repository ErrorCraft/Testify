{
  "schemaVersion": 1,
  "id": "testify",
  "version": "${version}",
  "name": "Testify",
  "description": "A mod that provides a common set of game tests for mods that want to ensure vanilla compatibility.",
  "authors": [
    "ErrorCraft"
  ],
  "contact": {
    "homepage": "https://errorcraft.net/testify",
    "sources": "https://github.com/ErrorCraft/Testify"
  },
  "license": "Apache-2.0",
  "icon": "assets/testify/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.errorcraft.testify.internal.Testify"
    ],
    "testify-gametest": [
      "net.errorcraft.testify.gametest.item.ArmorStandTestSuite",
      "net.errorcraft.testify.gametest.item.BeetrootSoupTestSuite",
      "net.errorcraft.testify.gametest.item.GoatHornTestSuite",
      "net.errorcraft.testify.gametest.item.HoneyBottleTestSuite",
      "net.errorcraft.testify.gametest.SimpleItemStackTestSuite"
    ]
  },
  "mixins": [
    "testify.mixins.json"
  ],
  "accessWidener": "testify.classtweaker",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
